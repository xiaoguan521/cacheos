[Unit]
Description=SyCache sentinel on port %i (CacheOS)
Documentation=man:sycache-sentinel(1)
After=network-online.target sycache-thp.service
Wants=network-online.target sycache-thp.service

[Service]
Type=notify
User=sycache
Group=sycache
ExecStart=/opt/sycache/current/bin/sycache-sentinel /opt/sycache/instances/%i/sycache-sentinel.conf --supervised systemd --daemonize no
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535
RuntimeDirectory=sycache
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/sycache/instances/%i /var/log/sycache
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
