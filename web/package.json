{
  "name": "cacheos-console-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && pnpm run build:portal:only",
    "preview": "vite preview",
    "lint": "eslint src src-portal",
    "build:portal": "vue-tsc --noEmit && pnpm run build:portal:only",
    "build:portal:only": "vite build -c vite.portal.config.ts && node -e \"require('fs').writeFileSync('portal/dist/.gitkeep','')\""
  },
  "dependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@vueuse/core": "^15.0.0",
    "ace-builds": "^1.36.0",
    "antdv-next": "~1.6.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0",
    "vue3-ace-editor": "2.2.4",
    "vue3-gettext": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.0.0"
  }
}
